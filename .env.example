# ============================================================
# Build In Social — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# Auth (Clerk — Sprint 9)
# https://dashboard.clerk.com → API Keys
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=svix_...

# Redirect URLs recognised by Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/identity

# Dev-only one-click sign-in. Set to 1 to enable the "Sign in as Test User"
# button on /login and /signup. Skips ClerkProvider and middleware. Cookie-driven
# (no auto-auth) so the login flow is exercised in dev. Production-safe: gated
# on NODE_ENV=development. Restart `next dev` after toggling.
NEXT_PUBLIC_DEV_AUTH=1

# Deprecated — use NEXT_PUBLIC_DEV_AUTH=1 above. Kept for one release.
# BYPASS_AUTH=true

# ------------------------------------------------------------
# Database (NoCodeBackend)
# https://nocodebackend.com → your instance
# ------------------------------------------------------------
NCB_DATA_API_URL=https://...
NCB_INSTANCE=...
NOCODEBACKEND_SECRET_KEY=...

# ------------------------------------------------------------
# AI (Anthropic Claude)
# Haiku for scripts/quality-gate; Sonnet for pSEO/intelligence
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Voice (ElevenLabs)
# ------------------------------------------------------------
ELEVENLABS_API_KEY=...

# ------------------------------------------------------------
# B-roll (Pexels)
# ------------------------------------------------------------
PEXELS_API_KEY=...

# ------------------------------------------------------------
# Storage (Cloudflare R2)
# ------------------------------------------------------------
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=buildinsocial-videos
R2_PUBLIC_URL=https://pub-xxx.r2.dev
CLOUDFLARE_ACCOUNT_ID=...

# ------------------------------------------------------------
# Payments (Stripe)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in your Stripe dashboard.
# Each tier has a monthly AND annual price id.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_CREATOR_ANNUAL=price_...
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...

# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------
RESEND_API_KEY=re_...

# ------------------------------------------------------------
# Job Queue (Upstash Redis)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ------------------------------------------------------------
# Internal
# ------------------------------------------------------------
INTERNAL_SECRET=change-me-in-production
CRON_SECRET=your-cron-secret-here
FFMPEG_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# ralph runtime state (logs, session, counters — not config)
.ralph/logs/
.ralph/live.log
.ralph/.call_count
.ralph/.token_count
.ralph/.last_reset
.ralph/.loop_start_sha
.ralph/.ralph_session
.ralph/.ralph_session_history
.ralph/.circuit_breaker_state
.ralph/.circuit_breaker_history
.ralph/.exit_signals
.ralph/.claude_session_id
.ralph/status.json

# typescript
*.tsbuildinfo
next-env.d.ts

# ux swarm reports (generated by /ux-swarm)
/.claude/swarm-reports/
